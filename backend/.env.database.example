# PostgreSQL Configuration
# Override these in production with secure credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rideshare

# Usage in docker-compose.yml:
# environment:
#   POSTGRES_USER: ${POSTGRES_USER:-postgres}
#   POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
#   POSTGRES_DB: ${POSTGRES_DB:-rideshare}
#
# The ${VAR:-default} syntax uses the environment variable if set,
# otherwise falls back to the default value.
#
# For production:
# 1. Create a .env file in backend/ directory
# 2. Set strong credentials
# 3. Never commit .env to version control
