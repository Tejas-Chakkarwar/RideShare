# Service Configuration
SERVICE_NAME=booking-service
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/rideshare

# API Configuration
API_V1_PREFIX=/api/v1

# Service URLs
RIDE_SERVICE_URL=http://ride-service:8000
USER_SERVICE_URL=http://user-service:8000

# Auth
SECRET_KEY=dev_secret_key_12345
ALGORITHM=HS256

# SendGrid Email Configuration (for MVP)
# For AWS deployment, switch to AWS SES (see email_client.py)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@sjsurideshare.com
SENDGRID_FROM_NAME=SJSU RideShare

# App URL for email links
APP_URL=http://localhost:3000
