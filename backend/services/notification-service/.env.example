# Service Configuration
SERVICE_NAME=notification-service
PORT=8004
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/rideshare

# Authentication
SECRET_KEY=dev_secret_key_change_in_production
ALGORITHM=HS256

# User Service URL (for fetching user details)
USER_SERVICE_URL=http://user-service:8000

# Email (SendGrid)
# Get your API Key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=notifications@sjsurideshare.com
SENDGRID_FROM_NAME="SJSU RideShare"

# Push Notifications (Firebase)
# Path to your service account JSON key file
FIREBASE_CREDENTIALS_PATH=app/firebase_credentials.json

# Web App URL (for email links)
APP_URL=http://localhost:3000
